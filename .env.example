# Default demo mode: deterministic and does not require an API key.
LLM_PROVIDER=mock

# Docker/Compose SQLite location. The compose file persists /data in a named volume.
DATABASE_URL=sqlite:////data/personaflow.db

# Only needed if LLM_PROVIDER is changed to anthropic in a future phase.
ANTHROPIC_API_KEY=

# Local Vite development can leave this empty and use the configured proxy.
VITE_API_BASE_URL=
